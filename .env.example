# OAuth 1.0a (required for x-as-user / employee LDAP access)
# From developer.x.com → your app → Keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional: override Ads API base (default https://ads-api.x.com/12)
# X_ADS_API_BASE=https://ads-api.x.com/12

# Optional fallback if OAuth1 is not set (usually will NOT work with x-as-user)
# X_ADS_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# The web console reads its own web/.env.local, not this file. Copy the block
# below there if you want it to use a specific developer app's keys.
#
# X_CONSUMER_KEY and X_CONSUMER_SECRET are the app's API Key and API Key Secret
# (the Consumer Keys section, not an access token). Setting them here takes
# precedence over anything pasted into the setup wizard, which is what you want
# when switching apps: the wizard's stored copy cannot then shadow the real one.
#
# Changing these invalidates any token you already authorized, because a token
# belongs to the app whose key signed for it. The console detects that and
# offers to re-authorize; nothing has to be deleted by hand.
#
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
#
# Optional, for Grok summaries:
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4.6
