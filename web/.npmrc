# Resolve from the public registry regardless of what the machine's global npm config says.
#
# A developer whose ~/.npmrc points at a corporate mirror writes that mirror's hostname into every
# `resolved` URL in package-lock.json. The install then works locally and fails on any host outside
# that network -- which is how this repo first reached Render: 493 URLs aimed at an internal
# Artifactory, and a build that died on getaddrinfo ENOTFOUND.
registry=https://registry.npmjs.org/
